d-foreground pointer-events-none absolute inset-y-0 end-0 flex items-center justify-center pe-2\"\n\t\t\t\t>\n\t\t\t\t\t<kbd\n\t\t\t\t\t\tclass=\"text-muted-foreground/70 inline-flex h-5 max-h-full items-center rounded border px-1 font-[inherit] text-[0.625rem] font-medium\"\n\t\t\t\t\t>\n\t\t\t\t\t\t⌘K\n\t\t\t\t\t</kbd>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t\t<!-- Right side -->\n\t\t<div class=\"flex flex-1 items-center justify-end gap-2\">\n\t\t\t<!-- Notification -->\n\t\t\t<NotificationMenu />\n\t\t\t<!-- User menu -->\n\t\t\t<UserMenu />\n\t\t</div>\n\t</div>\n\t<!-- Bottom navigation -->\n\t<div class=\"border-t py-2 max-md:hidden\">\n\t\t<!-- Navigation menu -->\n\t\t<NavigationMenuRoot>\n\t\t\t<NavigationMenuList class=\"gap-2\">\n\t\t\t\t{#each navigationLinks as link (link.label)}\n\t\t\t\t\t<NavigationMenuItem>\n\t\t\t\t\t\t<NavigationMenuLink\n\t\t\t\t\t\t\tactive={link.active}\n\t\t\t\t\t\t\thref={link.href}\n\t\t\t\t\t\t\tclass=\"text-muted-foreground hover:text-primary py-1.5 font-medium\"\n\t\t\t\t\t\t>\n\t\t\t\t\t\t\t{link.label}\n\t\t\t\t\t\t</NavigationMenuLink>\n\t\t\t\t\t</NavigationMenuItem>\n\t\t\t\t{/each}\n\t\t\t</NavigationMenuList>\n\t\t</NavigationMenuRoot>\n\t</div>\n</header>\n",
