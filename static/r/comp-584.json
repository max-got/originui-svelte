pan>\n\t\t\t</DropdownMenuItem>\n\t\t</DropdownMenuGroup>\n\t\t<DropdownMenuSeparator />\n\t\t<DropdownMenuGroup>\n\t\t\t<DropdownMenuItem>\n\t\t\t\t<PinIcon size={16} class=\"opacity-60\" aria-hidden=\"true\" />\n\t\t\t\t<span>Option 4</span>\n\t\t\t</DropdownMenuItem>\n\t\t\t<DropdownMenuItem>\n\t\t\t\t<UserPenIcon size={16} class=\"opacity-60\" aria-hidden=\"true\" />\n\t\t\t\t<span>Option 5</span>\n\t\t\t</DropdownMenuItem>\n\t\t</DropdownMenuGroup>\n\t\t<DropdownMenuSeparator />\n\t\t<DropdownMenuItem>\n\t\t\t<LogOutIcon size={16} class=\"opacity-60\" aria-hidden=\"true\" />\n\t\t\t<span>Logout</span>\n\t\t</DropdownMenuItem>\n\t</DropdownMenuContent>\n</DropdownMenu>\n",
