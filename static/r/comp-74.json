{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "comp-74",
	"type": "registry:component",
	"registryDependencies": [
		"label",
		"textarea"
	],
	"meta": {
		"tags": [
			"label",
			"textarea"
		]
	},
	"files": [
		{
			"content": "<script lang=\"ts\">\n\timport Label from '$lib/registry/default/ui/label.svelte';\n\timport Textarea from '$lib/registry/default/ui/textarea.svelte';\n\timport { useCharacterLimit } from '$lib/registry/default/hooks/use-character-limit.svelte';\n\n\tconst maxLength = 180;\n\tconst characterLimit = useCharacterLimit(maxLength);\n\n\tconst uid = $props.id();\n</script>\n\n<div class=\"*:not-first:mt-2\">\n\t<Label for={uid}>Textarea with characters left</Label>\n\t<Textarea\n\t\tid={uid}\n\t\tbind:value={characterLimit.value}\n\t\tmaxlength={characterLimit.maxLength}\n\t\taria-describedby=\"{uid}-characters-left-textarea\"\n\t/>\n\t<p\n\t\tid=\"{uid}-characters-left-textarea\"\n\t\tclass=\"text-muted-foreground mt-2 text-right text-xs\"\n\t\trole=\"status\"\n\t\taria-live=\"polite\"\n\t>\n\t\t<span class=\"tabular-nums\">{characterLimit.maxLength - characterLimit.characterCount}</span>\n\t\tcharacters left\n\t</p>\n</div>\n",
			"type": "registry:component",
			"target": "comp-74.svelte"
		},
		{
			"content": "export class CharacterLimit {\n\t#value = $state('');\n\tcharacterCount = $derived(this.#value.length);\n\tmaxLength: number;\n\n\tconstructor(maxLength: number, initialValue = '') {\n\t\tthis.maxLength = maxLength;\n\t\tthis.#value = initialValue;\n\t}\n\n\tset value(value: string) {\n\t\tif (value.length <= this.maxLength) {\n\t\t\tthis.#value = value;\n\t\t}\n\t}\n\n\tget value() {\n\t\treturn this.#value;\n\t}\n}\n\nexport function useCharacterLimit(maxLength: number, initialValue = '') {\n\treturn new CharacterLimit(maxLength, initialValue);\n}\n",
			"type": "registry:hook",
			"target": "use-character-limit.svelte.ts"
		}
	]
}