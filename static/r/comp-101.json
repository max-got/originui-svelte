{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "comp-101",
	"type": "registry:component",
	"dependencies": [
		"@lucide/svelte@^0.525.0"
	],
	"registryDependencies": [
		"toggle",
		"tooltip"
	],
	"meta": {
		"tags": [
			"button",
			"toggle"
		]
	},
	"files": [
		{
			"content": "<script lang=\"ts\">\n\timport Toggle from '$lib/registry/default/ui/toggle.svelte';\n\timport {\n\t\tTooltip,\n\t\tTooltipContent,\n\t\tTooltipProvider,\n\t\tTooltipTrigger\n\t} from '$lib/registry/default/ui/tooltip';\n\n\timport Bookmark from '@lucide/svelte/icons/bookmark';\n\n\tlet bookmarked = $state(false);\n</script>\n\n<TooltipProvider>\n\t<Tooltip>\n\t\t<TooltipTrigger aria-label=\"Bookmark this\">\n\t\t\t{#snippet child({ props })}\n\t\t\t\t<Toggle\n\t\t\t\t\tclass=\"group size-9 p-0 hover:bg-indigo-50 hover:text-indigo-500 data-[state=on]:bg-indigo-50 data-[state=on]:text-indigo-500\"\n\t\t\t\t\tpressed={bookmarked}\n\t\t\t\t\tonPressedChange={() => (bookmarked = !bookmarked)}\n\t\t\t\t\t{...props}\n\t\t\t\t>\n\t\t\t\t\t<Bookmark size={16} aria-hidden=\"true\" {...props} />\n\t\t\t\t</Toggle>\n\t\t\t{/snippet}\n\t\t</TooltipTrigger>\n\t\t<TooltipContent class=\"px-2 py-1 text-xs\">\n\t\t\t<p>{bookmarked ? 'Remove bookmark' : 'Bookmark this'}</p>\n\t\t</TooltipContent>\n\t</Tooltip>\n</TooltipProvider>\n",
			"type": "registry:component",
			"target": "comp-101.svelte"
		}
	]
}